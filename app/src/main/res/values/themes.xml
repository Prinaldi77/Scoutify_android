<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Scoutify" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main theme colors -->
        <item name="colorPrimary">@color/primaryBrown</item>
        <item name="colorPrimaryDark">@color/primaryDarkBrown</item>
        <item name="colorAccent">@color/primaryLightBrown</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:statusBarColor">@color/backgroundCream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/backgroundCream</item>
    </style>

    <style name="Theme.Scoutify" parent="Base.Theme.Scoutify" />

    <!-- Premium Custom Styles for Scoutify Outlined Box Inputs -->
    <style name="Widget.Scoutify.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primaryBrown</item>
        <item name="hintTextColor">@color/primaryBrown</item>
        <item name="startIconTint">@color/primaryLightBrown</item>
        <item name="endIconTint">@color/primaryLightBrown</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Scoutify.TextInputLayout.Corner</item>
    </style>

    <style name="ShapeAppearance.Scoutify.TextInputLayout.Corner" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Premium Style for Scoutify Buttons -->
    <style name="Widget.Scoutify.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primaryBrown</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Scoutify.Button.Corner</item>
    </style>

    <style name="ShapeAppearance.Scoutify.Button.Corner" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Calendar Style -->
    <style name="Widget.Scoutify.Calendar" parent="android:Widget.CalendarView">
        <item name="android:focusedMonthDateColor">@color/primaryBrown</item>
        <item name="android:selectedWeekBackgroundColor">@color/accent_beige</item>
        <item name="android:weekSeparatorLineColor">@android:color/transparent</item>
    </style>
</resources>